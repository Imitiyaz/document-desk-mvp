# Author: Imitiyaz and AI Agent
# Copy to root .env. Never store credentials or private endpoints here.
APP_ENV=development
LOG_LEVEL=INFO
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PREDICT=512
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
CHROMA_PERSIST_DIR=./data/processed/chroma_db
CHROMA_COLLECTION_NAME=documents
RETRIEVAL_TOP_K=5
# Uvicorn's explicit --host/--port control the actual listen address.
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=20971520
UPLOAD_TEMP_DIR=./data/processed/uploads
MAX_XLSX_EXPANDED_BYTES=104857600
MAX_EXTRACTED_ROWS=25000
MAX_PDF_PAGES=200
MAX_XLSX_COLUMNS=512
